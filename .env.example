# Disposable local demo credentials. Copy to .env; never reuse for a real deployment.
# Keep values URL-safe because Compose builds DATABASE_URL and RABBITMQ_URL from them.
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=platform_pass
POSTGRES_DB=platform_db
MINIO_ROOT_USER=platform_minio
MINIO_ROOT_PASSWORD=platform_minio_password
RABBITMQ_DEFAULT_USER=platform_user
RABBITMQ_DEFAULT_PASS=platform_rabbitmq_password
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=platform_grafana_password
